{
	"name": "dmn-zeit",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" dev",
		"test": "pnpm --filter \"./packages/*\" build && pnpm -r --filter \"!@zeit/e2e\" test",
		"lint": "eslint .",
		"depcruise": "depcruise apps/api/src apps/web/src packages/rules/src packages/shared/src packages/demo-data/src",
		"typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck",
		"format": "prettier --write \"**/*.{ts,tsx,mts,mjs,json,md,css}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,json,md,css}\"",
		"db:up": "docker compose -f compose.dev.yml up -d --wait",
		"db:down": "docker compose -f compose.dev.yml down",
		"e2e:up": "docker compose -f compose.test.yml up -d --wait --build",
		"e2e:down": "docker compose -f compose.test.yml down -v",
		"e2e": "pnpm e2e:up && pnpm --filter @zeit/e2e test",
		"db:dbmate": "docker run --rm --network zeit-dev_default -v ./db:/db ghcr.io/amacneil/dbmate:2.37.0 --url postgres://zeit_owner:zeit_owner@zeit-dev-db:5432/zeit?sslmode=disable",
		"db:migrate": "pnpm db:dbmate up",
		"db:rollback": "pnpm db:dbmate rollback",
		"db:new": "pnpm db:dbmate new",
		"db:codegen": "pnpm --filter @zeit/api exec kysely-codegen"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"dependency-cruiser": "^18.7.0",
		"eslint": "^10.13.0",
		"eslint-plugin-react-hooks": "^7.1.1",
		"prettier": "^3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.72.0"
	}
}
