{
	"name": "dmn-zeit",
	"version": "0.1.0",
	"private": true,
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24"
	},
	"scripts": {
		"build": "pnpm -r build",
		"dev": "pnpm --filter \"./packages/*\" build && pnpm --parallel --filter \"./apps/*\" dev",
		"test": "pnpm --filter \"./packages/*\" build && pnpm -r test",
		"lint": "eslint .",
		"typecheck": "pnpm --filter \"./packages/*\" build && pnpm -r typecheck",
		"format": "prettier --write \"**/*.{ts,tsx,mts,mjs,json,md,css}\"",
		"format:check": "prettier --check \"**/*.{ts,tsx,mts,mjs,json,md,css}\"",
		"db:up": "docker compose -f compose.dev.yml up -d --wait",
		"db:down": "docker compose -f compose.dev.yml down",
		"db:dbmate": "docker run --rm --network zeit-dev_default -v ./db:/db ghcr.io/amacneil/dbmate:2.36.0 --url postgres://zeit_owner:zeit_owner@zeit-dev-db:5432/zeit?sslmode=disable",
		"db:migrate": "pnpm db:dbmate up",
		"db:rollback": "pnpm db:dbmate rollback",
		"db:new": "pnpm db:dbmate new",
		"db:codegen": "pnpm --filter @zeit/api exec kysely-codegen --dialect postgres --url postgres://zeit_owner:zeit_owner@127.0.0.1:54330/zeit --exclude-pattern {auth.*,public.*,schema_migrations} --date-parser string --out-file src/db/schema.generated.ts"
	},
	"devDependencies": {
		"@eslint/js": "^10.0.1",
		"eslint": "^10.11.0",
		"prettier": "^3.9.8",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.70.1"
	}
}
