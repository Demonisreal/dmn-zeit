[zeit]
enabled = true
filter = zeit
logpath = /var/lib/docker/volumes/zeit-live-access-log/_data/zeit-access.log
          /var/lib/docker/volumes/zeit-demo-access-log/_data/zeit-access.log
maxretry = 8
findtime = 5m
bantime = 1h
banaction = iptables-allports[chain=DOCKER-USER]
ignoreip = 127.0.0.1/8 10.8.0.0/24
