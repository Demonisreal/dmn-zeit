# name of the external network the server's central caddy publishes, check with `docker network inspect` first
EDGE_NETWORK=edge
# subnet of that same network, so the web container only trusts x-forwarded-for from the central caddy: docker network inspect edge
EDGE_SUBNET=

# check both subnets against `docker network inspect` before first use, must not collide with other projects
LIVE_APP_SUBNET=172.28.11.0/24
LIVE_DB_SUBNET=172.28.12.0/24

# origin the spa is reachable under, compared verbatim against the browser's Origin header, https is mandatory in live
APP_ORIGIN=https://zeit.example.invalid

# postgres superuser, only used by the container entrypoint on first init: openssl rand -hex 32
POSTGRES_PASSWORD=
# owns the schema and runs migrations as zeit_owner: openssl rand -hex 32
ZEIT_OWNER_PASSWORD=
# runtime role of the api, nobypassrls: openssl rand -hex 32
ZEIT_APP_PASSWORD=
# read-only role for zeit-live-backup, bypassrls so pg_dump sees every row despite force rls: openssl rand -hex 32
ZEIT_BACKUP_PASSWORD=

# required in live mode, config.ts refuses to start without these
MAIL_FROM=
RESEND_API_KEY=
# 32 random bytes, base64: openssl rand -base64 32
PASSWORD_PEPPER=
# 32 random bytes, base64, used for the totp secrets: openssl rand -base64 32
DATA_ENCRYPTION_KEY=

# tag of a manual build on the server: git rev-parse --short HEAD; CI only builds, it never pushes an image.
# set it explicitly for every build, the fallback in compose.yml is only there so demo and live never share a tag
IMAGE_TAG=local

# where backup.sh drops dumps; set an absolute path outside the repo checkout on the server, this default is dev-only
BACKUP_DIR=./backups
