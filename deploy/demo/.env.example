# own edge network for this instance, not shared with live: docker network create --subnet 172.28.3.0/24 zeit-demo-edge
EDGE_NETWORK=zeit-demo-edge
# subnet of that same network, so the web container only trusts x-forwarded-for from the central caddy
EDGE_SUBNET=172.28.3.0/24

# check both subnets against `docker network inspect` before first use, must not collide with other projects
DEMO_APP_SUBNET=172.28.1.0/24
DEMO_DB_SUBNET=172.28.2.0/24

# origin the spa is reachable under, compared verbatim against the browser's Origin header
APP_ORIGIN=https://zeit-demo.example.invalid

# postgres superuser, only used by the container entrypoint on first init: openssl rand -hex 32
POSTGRES_PASSWORD=
# owns the schema and runs migrations as zeit_owner: openssl rand -hex 32
ZEIT_OWNER_PASSWORD=
# runtime role of the api, nobypassrls: openssl rand -hex 32
ZEIT_APP_PASSWORD=

# stay empty in demo: mails go to the outbox, config.ts falls back to fixed dev values for pepper and key
MAIL_FROM=
RESEND_API_KEY=
PASSWORD_PEPPER=
DATA_ENCRYPTION_KEY=

# tag of a manual build on the server: git rev-parse --short HEAD; CI only builds, it never pushes an image.
# set it explicitly for every build, the fallback in compose.yml is only there so demo and live never share a tag
IMAGE_TAG=local
