{
	"name": "@zeit/demo-data",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"sideEffects": false,
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.cts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.ts",
				"default": "./dist/index.js"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"test": "vitest run --passWithNoTests",
		"typecheck": "tsc --noEmit"
	},
	"dependencies": {
		"@zeit/rules": "workspace:*",
		"@zeit/shared": "workspace:*",
		"temporal-polyfill": "^1.0.5"
	},
	"devDependencies": {
		"tsup": "^9.0.0",
		"typescript": "~6.0.3",
		"vitest": "^5.0.1"
	}
}
